# ---- Claude Astra: server-side configuration ----
# Copy to .env.local for local dev. On Amplify Hosting set these as
# environment variables in the Console (App settings -> Environment variables).

# Region for Bedrock and S3 calls. us-east-1 has every model used here.
# Local dev: AWS_REGION is fine. On Amplify Hosting, names starting with "AWS" are
# reserved, so set ASTRA_BEDROCK_REGION instead (it takes precedence when both exist).
AWS_REGION=us-east-1
# ASTRA_BEDROCK_REGION=us-east-1

# Local dev only: credentials come from `aws configure` / AWS_PROFILE.
# On Amplify Hosting the SSR compute role supplies credentials; leave these unset there.
# AWS_PROFILE=default

# S3 bucket + prefix that Bedrock async video jobs (Nova Reel, Luma Ray 2) write to.
# Must be in the same region as ASTRA_BEDROCK_REGION / AWS_REGION. Created in docs/AWS_SETUP.md step 5.
ASTRA_MEDIA_BUCKET=claude-astra-media-<your-account-id>
ASTRA_MEDIA_PREFIX=videos/

# S3 bucket that holds per-user agent workspaces (files the agent reads/writes).
# When unset, the Amplify Storage bucket from amplify_outputs.json is used.
# ASTRA_WORKSPACE_BUCKET=

# Optional: Google Gemini (NOT available on Bedrock; calls Google's API directly).
# Get a key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# Optional: a Bedrock Agent (Agents for Amazon Bedrock) to expose in the UI.
# BEDROCK_AGENT_ID=
# BEDROCK_AGENT_ALIAS_ID=

# Optional: override the model catalog with a JSON file path (see lib/models.ts).
# ASTRA_MODELS_JSON=./models.custom.json

# Local dev only: skip Cognito and run as a single anonymous user.
# Never set this on a deployed environment.
# ASTRA_AUTH_MODE=none

# Routing prefix for Claude ids on Bedrock. Default "global" (routes anywhere, no premium).
# Use "us" to stay in the US geography, or "" for in-region only (us-east-1 etc.).
# ASTRA_CLAUDE_ROUTING=global

# Default model id (must exist in the catalog). Defaults to Claude Opus 5.5.
# ASTRA_DEFAULT_MODEL=claude-opus-5-5
