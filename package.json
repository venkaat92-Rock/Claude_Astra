{
  "name": "claude-astra",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Astra: a Claude Code-style agent workbench hosted on AWS Amplify, backed by Amazon Bedrock (Claude, Amazon Nova, Luma video) with optional Google Gemini.",
  "scripts": {
    "predev": "node scripts/ensure-amplify-outputs.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-amplify-outputs.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "node scripts/ensure-amplify-outputs.mjs && tsc --noEmit",
    "sandbox": "ampx sandbox",
    "check:bedrock": "tsx scripts/check-bedrock-access.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.35.0",
    "@anthropic-ai/sdk": "^0.134.0",
    "@aws-amplify/adapter-nextjs": "^1.8.1",
    "@aws-amplify/ui-react": "^6.15.7",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1152.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@google/genai": "^1.25.0",
    "aws-amplify": "^6.22.0",
    "docx": "^9.5.1",
    "fflate": "^0.8.3",
    "next": "^15.5.28",
    "pdf-parse": "^1.1.4",
    "pptxgenjs": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-sts": "^3.1152.0",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.28",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
